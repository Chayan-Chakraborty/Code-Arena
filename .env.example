# Host port mappings for `docker compose`.
# Defaults are safe on machines where 8080/3306/3000 are free.
# Override here (or via shell env) if those ports are taken.

BACKEND_HOST_PORT=8080
FRONTEND_HOST_PORT=3000
MYSQL_HOST_PORT=3306

# Must match BACKEND_HOST_PORT above. The frontend is built with this URL
# baked in, so the browser knows where to reach the API.
REACT_APP_API_BASE_URL=http://localhost:8080/api

# Judge0 (optional). Leave JUDGE0_API_KEY empty if your backend uses the local
# Java executor instead of Judge0.
JUDGE0_API_KEY=
JUDGE0_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_HOST=judge0-ce.p.rapidapi.com
